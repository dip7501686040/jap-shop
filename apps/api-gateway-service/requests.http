// API Gateway Service HTTP Requests

# Register a new user
# curl -X 'POST' \
#   'http://localhost:4001/api/auth/register' \
#   -H 'accept: */*' \
#   -H 'Content-Type: application/json' \
#   -d '{
#   "email": "test@example.com",
#   "password": "password",
#   "name": "Test user"
# }'

# Login an existing user
# curl -X 'POST' \
#   'https://janakalyanayurved.shop/api/auth/login' \
#   -H 'accept: application/json' \
#   -H 'Content-Type: application/json' \
#   -d '{
#   "email": "dip7001733750@gmail.com",
#   "password": "password"
# }'

# verify OTP
# curl -X 'POST' \
#   'https://janakalyanayurved.shop/api/auth/verify-otp' \
#   -H 'accept: application/json' \
#   -H 'Content-Type: application/json' \
#   -d '{
#   "email": "dip7001733750@gmail.com",
#   "otp": "886560"
# }'

